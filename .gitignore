# ============================================================
# Tiny Rogues 汉化补丁工程 - .gitignore
# 仅跟踪补丁文件（参考 v1.0 纯翻译发布包结构），排除游戏本体与运行时生成物
# ============================================================

# ---- 游戏本体（不纳入版本控制）----
/Tiny Rogues_Data/
/Tiny Rogues.exe
/GameAssembly.dll
/UnityPlayer.dll
/UnityCrashHandler64.exe
/baselib.dll

# ---- BepInEx 运行时生成物 ----
/BepInEx/cache/
/BepInEx/interop/
/BepInEx/ErrorLog.log
/BepInEx/LogOutput.log
/BepInEx/_en_mode_backup/

# ---- 诊断/捕获临时文件（_Tmp*）----
/BepInEx/Translation/zh/Text/_Tmp*.txt
/BepInEx/Translation/zh/Text/_AutoGeneratedTranslations.txt

# ---- 正则文件备份（.bak*）----
*.bak*
*.bak_*

# ---- 系统/编辑器临时文件 ----
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.swp
# ---- 发布 zip（不进仓库，仅作为 Release 附件）----
/TinyRogues_汉化补丁_*.zip

# ---- 旧版归档（tools/ 不再纳入版本控制，分享只需最新 release）----
/tools/

# ---- 个人工作流/测试脚本（与补丁效果无关，不随仓库分享）----
/push.ps1
/推送补丁.bat
/发布新版本.ps1
/发布新版本.bat
/switch_en.bat
/switch_en_hot.bat
/restore_cn.bat
/restore_cn_hot.bat

# ---- 调试用插件（ClassProbe 探测 DLL，与补丁效果无关）----
/BepInEx/plugins/TinyRogues.ClassProbe.dll

# ---- 调试插件 ClassProbe 的运行时输出（_Tmp* 诊断文件）----
/BepInEx/_Tmp*.txt

# ---- 发布 zip（ASCII 名，v1.6.1 起）----
/TinyRogues_zh_CN_*.zip
