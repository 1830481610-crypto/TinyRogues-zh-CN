# ============================================================
# Tiny Rogues 汉化补丁工程 - .gitignore
# 仅跟踪补丁文件（参考 v1.0 纯翻译发布包结构），排除游戏本体与运行时生成物
# ============================================================

# ---- 游戏本体（不纳入版本控制）----
/Tiny Rogues_Data/
/Tiny Rogues.exe
/GameAssembly.dll
/UnityPlayer.dll
/UnityCrashHandler64.exe
/baselib.dll

# ---- BepInEx 运行时生成物 ----
/BepInEx/cache/
/BepInEx/interop/
/BepInEx/ErrorLog.log
/BepInEx/LogOutput.log
/BepInEx/_en_mode_backup/

# ---- 诊断/捕获临时文件（_Tmp*）----
/BepInEx/Translation/zh/Text/_Tmp*.txt
/BepInEx/Translation/zh/Text/_AutoGeneratedTranslations.txt

# ---- 正则文件备份（.bak*）----
*.bak*
*.bak_*

# ---- 系统/编辑器临时文件 ----
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.swp